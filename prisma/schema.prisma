generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  ARCHIVED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PricingPriceType {
  FIXED
  STARTING_FROM
  CUSTOM_QUOTE
  CONTACT_FOR_PRICING
}

enum PricingBillingInterval {
  ONE_TIME
  HOURLY
  DAILY
  MONTHLY
  ANNUALLY
}

enum CurrencyCode {
  KES
  USD
  EUR
}

enum EstimatorRuleType {
  BASE
  FEATURE
  COMPLEXITY
  INTEGRATION
  CONTINGENCY
}

enum QuoteStatus {
  NEW
  REVIEWING
  CONTACTED
  QUOTATION_SENT
  NEGOTIATION
  ACCEPTED
  DECLINED
  CONVERTED
  ARCHIVED
}

model User {
  id            String            @id @default(cuid())
  name          String
  email         String            @unique
  passwordHash  String
  role          Role              @default(EDITOR)
  isActive      Boolean           @default(true)
  inquiries     Inquiry[]         @relation("AssignedInquiries")
  quoteRequests QuoteRequest[]    @relation("AssignedQuoteRequests")
  notes         InquiryNote[]
  quoteNotes    QuoteNote[]
  activities    InquiryActivity[]
  blogPosts     BlogPost[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Service {
  id               String                    @id @default(cuid())
  title            String
  slug             String                    @unique
  shortDescription String
  description      String                    @db.Text
  category         String
  businessProblems String[]                  @default([])
  features         String[]                  @default([])
  deliverables     String[]                  @default([])
  technologies     String[]                  @default([])
  benefits         String[]                  @default([])
  useCases         String[]                  @default([])
  faqs             Json                      @default("[]")
  icon             String                    @default("Code2")
  coverImage       String?
  deliveryEstimate String?
  priceType        PricingPriceType          @default(CUSTOM_QUOTE)
  amount           Decimal?                  @db.Decimal(12, 2)
  currency         CurrencyCode              @default(KES)
  billingInterval  PricingBillingInterval?
  pricingPlanId    String?
  pricingPlan      PricingPlan?              @relation(fields: [pricingPlanId], references: [id], onDelete: SetNull)
  relatedProjects  ServicePortfolioProject[]
  status           ContentStatus             @default(PUBLISHED)
  isActive         Boolean                   @default(true)
  sortOrder        Int                       @default(0)
  seoTitle         String?
  seoDescription   String?
  seoCanonicalUrl  String?
  inquiries        Inquiry[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([isActive, sortOrder])
  @@index([category, status, sortOrder])
  @@index([pricingPlanId])
}

model PricingCategory {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  plans       PricingPlan[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isActive, sortOrder])
}

model PricingPlan {
  id              String                  @id @default(cuid())
  name            String
  slug            String                  @unique
  categoryId      String
  category        PricingCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description     String                  @db.Text
  priceType       PricingPriceType        @default(FIXED)
  amount          Decimal?                @db.Decimal(12, 2)
  currency        CurrencyCode            @default(KES)
  billingInterval PricingBillingInterval?
  features        String[]
  exclusions      String[]
  scope           String?
  isFeatured      Boolean                 @default(false)
  isPopular       Boolean                 @default(false)
  isActive        Boolean                 @default(true)
  sortOrder       Int                     @default(0)
  ctaLabel        String                  @default("Choose plan")
  seoTitle        String?
  seoDescription  String?
  services        Service[]
  quoteRequests   QuoteRequest[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([categoryId, isActive, sortOrder])
}

model EstimatorRule {
  id         String            @id @default(cuid())
  category   String
  key        String
  label      String
  ruleType   EstimatorRuleType
  amount     Decimal?          @db.Decimal(12, 2)
  multiplier Decimal?          @db.Decimal(10, 4)
  isActive   Boolean           @default(true)
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([category, key])
  @@index([category, isActive, sortOrder])
}

model QuoteRequest {
  id                  String       @id @default(cuid())
  referenceNumber     String       @unique
  fullName            String
  email               String
  phone               String?
  company             String?
  serviceType         String?
  pricingPlanId       String?
  pricingPlan         PricingPlan? @relation(fields: [pricingPlanId], references: [id], onDelete: SetNull)
  pricingPlanSnapshot Json?
  projectDescription  String       @db.Text
  requestedFeatures   String?
  budget              String?
  timeline            String?
  estimateMin         Decimal?     @db.Decimal(12, 2)
  estimateMax         Decimal?     @db.Decimal(12, 2)
  currency            CurrencyCode @default(KES)
  status              QuoteStatus  @default(NEW)
  assignedToId        String?
  assignedTo          User?        @relation("AssignedQuoteRequests", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes               QuoteNote[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([pricingPlanId])
}

model QuoteNote {
  id             String       @id @default(cuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([quoteRequestId, createdAt])
}

model PortfolioProject {
  id                      String                    @id @default(cuid())
  title                   String
  slug                    String                    @unique
  summary                 String
  challenge               String                    @db.Text
  solution                String                    @db.Text
  features                String[]
  technologies            String[]
  category                String
  coverImage              String?
  gallery                 String[]
  liveUrl                 String?
  repositoryUrl           String?
  isFeatured              Boolean                   @default(false)
  status                  ContentStatus             @default(DRAFT)
  publishedAt             DateTime?
  seoTitle                String?
  seoDescription          String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  services               ServicePortfolioProject[]

  @@index([status, isFeatured, publishedAt])
}

model Inquiry {
  id                     String            @id @default(cuid())
  referenceNumber        String            @unique
  fullName               String
  email                  String
  phone                  String?
  company                String?
  serviceId              String?
  service                Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceNameSnapshot    String?
  budget                 String?
  timeline               String?
  description            String            @db.Text
  preferredContactMethod String            @default("EMAIL")
  status                 InquiryStatus     @default(NEW)
  assignedToId           String?
  assignedTo             User?             @relation("AssignedInquiries", fields: [assignedToId], references: [id], onDelete: SetNull)
  followUpAt             DateTime?
  notes                  InquiryNote[]
  activities             InquiryActivity[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([serviceId, createdAt])
  @@index([email])
}

model InquiryNote {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inquiryId, createdAt])
}

model InquiryActivity {
  id            String   @id @default(cuid())
  inquiryId     String
  inquiry       Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action        String
  previousValue String?
  newValue      String?
  createdAt     DateTime @default(now())

  @@index([inquiryId, createdAt])
}

model BlogPost {
  id             String                    @id @default(cuid())
  title          String
  slug           String                    @unique
  excerpt        String
  content        String                    @db.Text
  coverImage     String?
  authorId       String
  author         User                      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category       String
  tags           String[]
  status         ContentStatus             @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([status, publishedAt])
  @@index([category, status])
}

model ServicePortfolioProject {
  serviceId  String
  projectId  String
  service    Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  project    PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@id([serviceId, projectId])
  @@index([projectId])
}

model Testimonial {
  id            String   @id @default(cuid())
  clientName    String
  clientCompany String?
  clientRole    String?
  content       String   @db.Text
  rating        Int?
  isApproved    Boolean  @default(false)
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isPublished, isApproved])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}
